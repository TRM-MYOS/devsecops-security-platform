# Reference only: export these environment variables before starting the app.
# No passwords or session secrets belong in this file.
DEVSECOPS_ENV=development
DEVSECOPS_DATABASE_PATH=devsecops.db
DEVSECOPS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DEVSECOPS_COOKIE_SECURE=false
DEVSECOPS_SESSION_TTL_SECONDS=28800
DEVSECOPS_LOGIN_MAX_ATTEMPTS=5
DEVSECOPS_LOGIN_WINDOW_SECONDS=900
DEVSECOPS_SCANNER_TIMEOUT_SECONDS=600

# GitHub Actions monitoring: install a GitHub App with Actions/Contents read access.
# Keep the private key outside the repository. This file is not loaded automatically.
DEVSECOPS_GITHUB_APP_ID=5334246
DEVSECOPS_GITHUB_INSTALLATION_ID=171811806
DEVSECOPS_GITHUB_PRIVATE_KEY_PATH="C:\Users\Hack_for_die\Desktop\trm-myos-security-dashboard.2026-10-15.private-key.pem"
DEVSECOPS_GITHUB_WORKFLOW=security-gate.yml
